# =============================================================================
# Environment API untuk PRODUKSI
#
# Salin ke tempat rahasia dikelola (secret manager penyedia hosting, bukan file
# di dalam repo), lalu isi setiap nilai. Aplikasi menolak menyala bila ada yang
# masih memakai nilai contoh — lihat apps/api/src/config/env.skema.ts.
# =============================================================================

NODE_ENV="production"
PORT=4000

# --- Database ----------------------------------------------------------------
# Pakai koneksi ber-SSL. Sertakan connection pool limit bila penyedia
# databasenya membatasi jumlah koneksi.
DATABASE_URL="postgresql://PENGGUNA:SANDI@HOST:5432/ecommerce?sslmode=require&connection_limit=10"

# --- Auth --------------------------------------------------------------------
# WAJIB acak dan unik per environment. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mengganti nilai ini akan mengeluarkan semua admin dan pelanggan dari sesinya.
JWT_SECRET="ISI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER"
JWT_EXPIRES_IN="8h"
CUSTOMER_JWT_EXPIRES_IN="30d"

# --- CORS --------------------------------------------------------------------
# Origin frontend, wajib https. Pisahkan dengan koma bila lebih dari satu
# (mis. domain apex dan www).
WEB_ORIGIN="https://toko.example.id,https://www.toko.example.id"

# --- Penyimpanan gambar ------------------------------------------------------
# UPLOAD_DIR harus menunjuk ke volume yang bertahan melewati deploy ulang.
# Container tanpa volume akan kehilangan seluruh gambar produk saat di-restart.
# Rencana berikutnya: ganti UploadService ke Cloudflare R2
# (research/tech/09-storage-cdn-media.md).
UPLOAD_DIR="/data/uploads"
PUBLIC_BASE_URL="https://api.toko.example.id"

# --- Pengiriman (Biteship) ---------------------------------------------------
# Tanpa API key, ongkir memakai tabel tarif perkiraan — cukup untuk demo, TIDAK
# layak produksi karena angkanya bukan tarif resmi kurir.
# GUDANG_AREA_ID atau GUDANG_KODE_POS wajib diisi bila API key ada; tanpa titik
# asal, Biteship tidak bisa menghitung dan sistem diam-diam jatuh ke tarif lokal.
BITESHIP_API_KEY=""
BITESHIP_BASE_URL="https://api.biteship.com"
BITESHIP_KURIR="jne,jnt,sicepat,anteraja,pos,tiki"
GUDANG_AREA_ID=""
GUDANG_KODE_POS=""

# --- Pembayaran (Midtrans) ---------------------------------------------------
# Key PRODUKSI tidak berawalan "SB-Mid-". Memasang key sandbox di sini membuat
# pembayaran tidak pernah benar-benar tertagih; kebalikannya menghasilkan
# "401 Unknown Merchant server_key". Keduanya ditolak saat boot.
MIDTRANS_SERVER_KEY="Mid-server-XXXXXXXXXXXXXXXX"
MIDTRANS_CLIENT_KEY="Mid-client-XXXXXXXXXXXXXXXX"
MIDTRANS_PRODUKSI="true"

# Batas waktu pembayaran sebelum pesanan hangus (menit). 1440 = 24 jam.
BATAS_BAYAR_MENIT="1440"

# --- Pembatasan laju ---------------------------------------------------------
# Permintaan per menit per IP. Batas login sengaja jauh lebih ketat.
RATE_LIMIT_UMUM="300"
RATE_LIMIT_LOGIN="10"

# Jumlah proxy tepercaya di depan API. Salah setel membuat pembatasan laju
# memakai IP yang bisa dipalsukan lewat header X-Forwarded-For.
#   - 1 bila hanya ada satu load balancer
#   - 2 bila ada CDN di depan load balancer (mis. Cloudflare + LB)
TRUST_PROXY="1"

# --- Seed --------------------------------------------------------------------
# Hanya dipakai `npm run db:seed`. Ganti sandinya sebelum dijalankan, lalu
# ganti lagi lewat panel admin setelah login pertama.
SEED_ADMIN_EMAIL="admin@toko.example.id"
SEED_ADMIN_PASSWORD="GANTI_SEBELUM_SEED"
