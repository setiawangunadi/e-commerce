# Database (sesuai docker-compose.yml di root — port 5433 agar tidak bentrok dengan Postgres lokal)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5433/ecommerce"

# API
PORT=4000
NODE_ENV=development

# Auth admin — WAJIB diganti dengan nilai acak panjang di production
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
JWT_EXPIRES_IN="8h"

# CORS — origin frontend Next.js
WEB_ORIGIN="http://localhost:3000"

# Upload gambar produk (lokal untuk development).
# Di production diganti Cloudflare R2 — lihat research/tech/09-storage-cdn-media.md
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:4000"

# Kredensial admin pertama yang dibuat oleh `npm run db:seed`
SEED_ADMIN_EMAIL="admin@toko.local"
SEED_ADMIN_PASSWORD="admin12345"

# --- Pengiriman ---------------------------------------------------------
# Biteship: agregator kurir Indonesia (research/tech/06-shipping-integration.md).
# Kosongkan untuk memakai tarif perkiraan bawaan (cukup untuk development).
BITESHIP_API_KEY=""
BITESHIP_BASE_URL="https://api.biteship.com"
BITESHIP_KURIR="jne,jnt,sicepat,anteraja,pos,tiki"
# Titik asal pengiriman — isi salah satu (area id lebih akurat daripada kode pos)
GUDANG_AREA_ID=""
GUDANG_KODE_POS=""

# --- Pembayaran (Midtrans Snap) ----------------------------------------
# Ambil dari dashboard.midtrans.com > Settings > Access Keys.
# Selama kosong, checkout tetap jalan sampai pesanan dibuat, lalu berhenti
# di langkah bayar dengan pesan yang jelas.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_PRODUKSI="false"

# Batas waktu pembayaran sebelum pesanan hangus (menit). 1440 = 24 jam.
BATAS_BAYAR_MENIT="1440"
