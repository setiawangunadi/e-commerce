# =============================================================================
# Environment etalase untuk PRODUKSI
#
# PENTING: seluruh variabel NEXT_PUBLIC_* dibaca saat BUILD dan ter-inline ke
# bundel yang dikirim ke browser. Mengubahnya menuntut BUILD ULANG — menyetel
# ulang variabel lalu me-restart container tidak akan berpengaruh apa pun.
#
# Karena itu jangan pernah menaruh rahasia di sini: isinya bisa dibaca siapa
# pun yang membuka source halaman.
# =============================================================================

# URL API NestJS yang bisa dijangkau dari browser pembeli, bukan alamat
# internal container.
NEXT_PUBLIC_API_URL="https://api.toko.example.id"

# URL publik situs — dipakai untuk canonical, structured data, dan tautan di
# pesan WhatsApp. Tanpa garis miring di akhir.
NEXT_PUBLIC_SITE_URL="https://toko.example.id"

# Identitas toko di header, footer, dan metadata SEO.
NEXT_PUBLIC_NAMA_TOKO="Nusakara"
NEXT_PUBLIC_TAGLINE_TOKO="Perlengkapan harian buatan lokal"
NEXT_PUBLIC_WHATSAPP="628XXXXXXXXXX"

# Menentukan skrip Snap mana yang dimuat halaman pembayaran. HARUS "true" bila
# MIDTRANS_PRODUKSI di API juga "true" — kalau tidak sinkron, popup pembayaran
# menunjuk lingkungan yang berbeda dari transaksi yang dibuat server.
NEXT_PUBLIC_MIDTRANS_PRODUKSI="true"
